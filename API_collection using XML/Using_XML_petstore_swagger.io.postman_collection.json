          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Check the Name\", function(){\n    var jsonData = xml2Json(pm.response.text());\n    pm.expect(jsonData.Pet.name).to.eq(\"doggie\");\n});\n\n// captured value as collection variable \nvar jsonData = xml2Json(pm.response.text());\npm.collectionVariables.set(\"petid\", jsonData.Pet.id);"
            ]
          }
        }
