      "name": "Login(Extract) token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response has 'token' property\", function(){\r\n    var jsonData =pm.response.json();\r\n    pm.expect(jsonData).to.have.property('token');\r\n    pm.environment.set('token', jsonData.token)\r\n    console.log('token value is ; ', jsonData.token)\r\n    console.log('token value is ; ', pm.environment.get('token'))\r\n});\r\nconsole.log('pre-req-time: ', pm.environment.get('time now'))\r\n\r\n\r\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();\nconst dd = String(now.getDate()).padStart(2, '0');\nconst yyyy = now.getFullYear();\nconst HH = String(now.getHours()).padStart(2, '0');\nconst mm = String(now.getMinutes()).padStart(2, '0');\nconst ss = String(now.getSeconds()).padStart(2, '0');\nconst formatted = `${dd}-${yyyy} ${HH}:${mm}:${ss}`;\npm.environment.set('time now', formatted);\nconsole.log('pre-req-time : ', pm.environment.get('time now'))"
            ]
          }
        }
